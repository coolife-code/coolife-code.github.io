---
import Layout from '../layouts/Layout.astro';
---

<Layout title="About - Personal Page" currentPage="/about">
  <div class="page-container">
    <div class="page-content">
      <header class="page-header">
        <h1 class="page-title">
          <span class="title-word" style="animation-delay: 0s">ABOUT</span>
        </h1>
      </header>

      <div class="about-content">
        <div class="about-text">
          <p class="about-paragraph" style="animation-delay: 0.2s">
            欢迎来到我的个人角落。
          </p>
          <p class="about-paragraph" style="animation-delay: 0.3s">
            这里记录着我的阅读轨迹，也收纳着我做过的项目和一些还没成形的想法。
            每读完一本书，都会像推开一扇新的门；每完成一个项目，都是我和好奇心的一次对话。
          </p>
          <p class="about-paragraph" style="animation-delay: 0.4s">
            我始终相信，持续学习和持续创造会慢慢塑造一个人。
            阅读让我更理解世界，创造让我更理解自己。
          </p>
        </div>

      </div>
    </div>
  </div>
</Layout>

<style>
  @keyframes fadeInUp {
    from {
      opacity: 0;
      transform: translateY(20px);
    }
    to {
      opacity: 1;
      transform: translateY(0);
    }
  }

  .page-container {
    min-height: 100vh;
    padding-top: 8rem;
    padding-bottom: 4rem;
    padding-left: 1.5rem;
    padding-right: 1.5rem;
  }

  @media (min-width: 768px) {
    .page-container {
      padding-top: 10rem;
      padding-left: 2rem;
      padding-right: 2rem;
    }
  }

  .page-content {
    max-width: 48rem;
    margin-left: auto;
    margin-right: auto;
  }

  .page-header {
    text-align: center;
    margin-bottom: 5rem;
  }

  .page-title {
    margin-bottom: 1.5rem;
  }

  .title-word {
    display: block;
    font-size: 2.25rem;
    font-weight: 800;
    letter-spacing: 0.05em;
    text-transform: uppercase;
    line-height: 1.1;
    animation: fadeInUp 0.8s cubic-bezier(0.16, 1, 0.3, 1) forwards;
    opacity: 0;
  }

  @media (min-width: 768px) {
    .title-word {
      font-size: 3rem;
    }
  }

  @media (min-width: 1024px) {
    .title-word {
      font-size: 4.5rem;
    }
  }

  .about-content {
    text-align: center;
  }

  .about-text {
    margin-bottom: 5rem;
  }

  .about-paragraph {
    color: rgb(156, 163, 175);
    font-size: 1rem;
    line-height: 2;
    margin-bottom: 1.5rem;
    max-width: 36rem;
    margin-left: auto;
    margin-right: auto;
    opacity: 0;
    animation: fadeInUp 0.6s cubic-bezier(0.16, 1, 0.3, 1) forwards;
  }

  @media (min-width: 768px) {
    .about-paragraph {
      font-size: 1.125rem;
    }
  }

</style>
