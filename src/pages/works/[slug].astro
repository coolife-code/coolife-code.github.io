---
import Layout from '../../layouts/Layout.astro';
import { works } from '../../data/site';
import CsustdateShowcase from '../../components/works/CsustdateShowcase.astro';
import ReacordShowcase from '../../components/works/ReacordShowcase.astro';
import AletheiaShowcase from '../../components/works/AletheiaShowcase.astro';
import IfnoaiShowcase from '../../components/works/IfnoaiShowcase.astro';

export async function getStaticPaths() {
  return works.map((work) => ({
    params: { slug: work.slug },
    props: { work },
  }));
}

const { work } = Astro.props;
const componentMap = {
  csustdate: CsustdateShowcase,
  reacord: ReacordShowcase,
  'aleth-eia': AletheiaShowcase,
  ifnoai: IfnoaiShowcase,
} as const;

const WorkComponent = componentMap[work.slug as keyof typeof componentMap];
---

<Layout title={`${work.title} - Even The Devil Smiles`} currentPage="/works">
  {WorkComponent ? <WorkComponent work={work} /> : null}
</Layout>
