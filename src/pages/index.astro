---
import Layout from '../layouts/Layout.astro';
import HomeLayer from '../components/home/HomeLayer.astro';
import RadialMenu from '../components/home/RadialMenu.astro';
import DepthLayer from '../components/home/DepthLayer.astro';
import { siteConfig } from '../data/site';
---

<Layout title={siteConfig.title} currentPage="/">
  <!-- 字体引入 -->
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=VT323&display=swap" rel="stylesheet">

  <!-- 首页层 -->
  <HomeLayer />

  <!-- 圆盘导航菜单 -->
  <RadialMenu />

  <!-- 深度预览层 -->
  <DepthLayer />
</Layout>

<!-- 引入样式 -->
<link rel="stylesheet" href="/src/styles/home/index.css">

<!-- 引入交互脚本 -->
<script>
  import { initHomeInteractions } from '../scripts/home/interactions';
  
  // 初始化交互
  document.addEventListener('DOMContentLoaded', () => {
    initHomeInteractions();
  });
</script>
