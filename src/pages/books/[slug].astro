---
import Layout from '../../layouts/Layout.astro';
import { books } from '../../data/books';

export async function getStaticPaths() {
  const specialBookSlugs = new Set(['ares-childhood-1', 'our-ancestors', 'haishi-shenlou']);

  return books
    .filter((book) => !specialBookSlugs.has(book.slug))
    .map((book) => ({
      params: { slug: book.slug },
      props: { book },
    }));
}

const { book } = Astro.props;
---

<Layout title={`${book.title} - Books`} description={book.intro} currentPage="/books">
  <div class="detail-container">
    <a href="/books" class="back-btn">
      <span class="back-arrow">←</span>
      <span class="back-text">BACK TO BOOKS</span>
    </a>

    <div class="hero-section">
      <div class="image-frame">
        <div class="image-placeholder" aria-hidden="true">
          <span class="placeholder-tag">{book.category}</span>
          <span class="placeholder-text">{book.title}</span>
        </div>
      </div>
    </div>

    <div class="info-section">
      <h1 class="detail-title">{book.title}</h1>
      <p class="detail-subtitle">{book.subtitle}</p>
      <p class="detail-author">{book.author}</p>
      <p class="detail-year">{book.year}</p>
      <p class="detail-intro">{book.intro}</p>

      <div class="tag-list">
        {book.tags.map((tag) => (
          <span class="tag-chip">{tag}</span>
        ))}
      </div>

      <div class="body-preview">
        {book.body.slice(0, 8).map((paragraph) => (
          <p>{paragraph}</p>
        ))}
      </div>
    </div>
  </div>
</Layout>

<style>
  .detail-container {
    min-height: 100vh;
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: 2rem;
    align-items: start;
    padding: 7rem 1.5rem 4rem;
    position: relative;
    max-width: 1100px;
    margin: 0 auto;
  }

  .back-btn {
    grid-column: 1 / -1;
    display: flex;
    align-items: center;
    gap: 0.75rem;
    color: rgb(226, 232, 240);
    text-decoration: none;
    transition: all 0.3s ease;
    font-size: 0.8rem;
    letter-spacing: 0.18em;
    text-transform: uppercase;
  }

  .back-btn:hover {
    opacity: 0.78;
  }

  .back-arrow {
    font-size: 1.25rem;
  }

  .back-text {
    font-size: 0.75rem;
  }

  .hero-section {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 100%;
  }

  .image-frame {
    width: 100%;
    max-width: 520px;
    aspect-ratio: 4/5;
    border: 1px solid rgba(148, 163, 184, 0.18);
    padding: 1.5rem;
    border-radius: 1.8rem;
    transition: all 0.6s cubic-bezier(0.16, 1, 0.3, 1);
    background: rgba(15, 23, 42, 0.4);
  }

  @media (min-width: 768px) {
    .image-frame {
      padding: 2rem;
    }
  }

  .image-frame:hover {
    transform: scale(1.02);
    box-shadow: 0 0 80px rgba(59, 130, 246, 0.08);
  }

  .image-placeholder {
    width: 100%;
    height: 100%;
    background:
      radial-gradient(circle at top, rgba(96, 165, 250, 0.18), transparent 30%),
      linear-gradient(135deg, rgba(255,255,255,0.04) 0%, rgba(255,255,255,0.02) 100%);
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    position: relative;
    overflow: hidden;
    border-radius: 1.2rem;
  }

  .image-placeholder::before {
    content: '';
    position: absolute;
    inset: 0;
    background: 
      linear-gradient(90deg, transparent 50%, rgba(255,255,255,0.03) 50%),
      linear-gradient(transparent 50%, rgba(255,255,255,0.03) 50%);
    background-size: 20px 20px;
    opacity: 0.5;
  }

  .placeholder-tag {
    position: absolute;
    top: 1rem;
    left: 1rem;
    color: rgb(74, 222, 128);
    font-size: 0.72rem;
    letter-spacing: 0.22em;
    text-transform: uppercase;
    z-index: 1;
  }

  .placeholder-text {
    font-size: 1.25rem;
    letter-spacing: 0.2em;
    color: white;
    text-transform: uppercase;
    z-index: 1;
  }

  @media (min-width: 768px) {
    .placeholder-text {
      font-size: 1.5rem;
    }
  }

  .info-section {
    border: 1px solid rgba(148, 163, 184, 0.12);
    border-radius: 1.8rem;
    padding: 1.5rem;
    background: rgba(15, 23, 42, 0.62);
  }

  .detail-title {
    font-size: 1.5rem;
    font-weight: 700;
    letter-spacing: 0.08em;
    margin-bottom: 0.5rem;
  }

  @media (min-width: 768px) {
    .detail-title {
      font-size: 2rem;
    }
  }

  .detail-subtitle {
    color: rgba(255, 255, 255, 0.75);
    line-height: 1.8;
    margin-bottom: 1rem;
  }

  .detail-author {
    font-size: 0.875rem;
    color: rgba(255, 255, 255, 0.7);
    letter-spacing: 0.15em;
    margin-bottom: 0.5rem;
  }

  .detail-year {
    font-size: 0.875rem;
    color: rgba(255, 255, 255, 0.5);
    letter-spacing: 0.2em;
  }

  .detail-intro {
    margin-top: 1.2rem;
    color: rgb(203, 213, 225);
    line-height: 1.9;
  }

  .tag-list {
    display: flex;
    flex-wrap: wrap;
    gap: 0.6rem;
    margin-top: 1.2rem;
  }

  .tag-chip {
    padding: 0.42rem 0.7rem;
    border-radius: 999px;
    background: rgba(30, 41, 59, 0.95);
    border: 1px solid rgba(148, 163, 184, 0.12);
    color: rgb(226, 232, 240);
    font-size: 0.78rem;
  }

  .body-preview {
    display: grid;
    gap: 0.9rem;
    margin-top: 1.4rem;
  }

  .body-preview p {
    margin: 0;
    color: rgb(241, 245, 249);
    line-height: 1.95;
  }

  @media (min-width: 900px) {
    .detail-container {
      grid-template-columns: minmax(320px, 500px) minmax(0, 1fr);
      padding-top: 8rem;
    }

    .info-section {
      padding: 2rem;
    }
  }
</style>
