---
import Layout from '../layouts/Layout.astro';
import RadialMenu from '../components/home/RadialMenu.astro';
import PageNav from '../components/PageNav.astro';

const socialLinks = [
  {
    name: 'GitHub',
    handle: '@coolife-code',
    url: 'https://github.com/coolife-code',
    description: 'Code & Projects',
  },
  {
    name: 'X',
    handle: '@artthou251323',
    url: 'https://x.com/artthou251323',
    description: 'Thoughts & Updates',
  },
  {
    name: 'Email',
    handle: '318044943@qq.com',
    url: 'mailto:318044943@qq.com',
    description: 'Get in Touch',
  },
];
---

<Layout title="Social - Personal Page" currentPage="/social">
  <!-- 圆盘导航菜单 -->
  <RadialMenu />
  
  <!-- 页面底部导航 -->
  <PageNav />
  
  <div class="page-container">
    <div class="page-content">
      <header class="page-header">
        <h1 class="page-title">
          <span class="title-word" style="animation-delay: 0s">SOCIAL</span>
        </h1>
        <p class="page-subtitle">
          CONNECT WITH ME
        </p>
      </header>

      <div class="social-grid">
        {socialLinks.map((link, index) => (
          <a 
            href={link.url}
            target={link.url.startsWith('http') ? '_blank' : undefined}
            rel={link.url.startsWith('http') ? 'noopener noreferrer' : undefined}
            class="social-card"
            style={`animation-delay: ${(index + 1) * 0.1}s`}
          >
            <div class="social-header">
              <h2 class="social-name">{link.name}</h2>
              <span class="social-arrow">→</span>
            </div>
            <span class="social-handle">{link.handle}</span>
            <p class="social-description">{link.description}</p>
          </a>
        ))}
      </div>
    </div>
  </div>
</Layout>

<style>
  @keyframes fadeInUp {
    from {
      opacity: 0;
      transform: translateY(20px);
    }
    to {
      opacity: 1;
      transform: translateY(0);
    }
  }

  .page-container {
    min-height: 100vh;
    padding-top: 8rem;
    padding-bottom: 6rem;
    padding-left: 1.5rem;
    padding-right: 1.5rem;
  }

  @media (min-width: 768px) {
    .page-container {
      padding-top: 10rem;
      padding-left: 2rem;
      padding-right: 2rem;
    }
  }

  .page-content {
    max-width: 48rem;
    margin-left: auto;
    margin-right: auto;
  }

  .page-header {
    text-align: center;
    margin-bottom: 5rem;
  }

  .page-title {
    margin-bottom: 1.5rem;
  }

  .title-word {
    display: block;
    font-size: 2.25rem;
    font-weight: 800;
    letter-spacing: 0.05em;
    text-transform: uppercase;
    line-height: 1.1;
    animation: fadeInUp 0.8s cubic-bezier(0.16, 1, 0.3, 1) forwards;
    opacity: 0;
  }

  @media (min-width: 768px) {
    .title-word {
      font-size: 3rem;
    }
  }

  @media (min-width: 1024px) {
    .title-word {
      font-size: 4.5rem;
    }
  }

  .page-subtitle {
    color: rgb(156, 163, 175);
    letter-spacing: 0.2em;
    text-transform: uppercase;
    font-size: 0.875rem;
  }

  @media (min-width: 768px) {
    .page-subtitle {
      font-size: 1rem;
    }
  }

  .social-grid {
    display: flex;
    flex-direction: column;
    gap: 1rem;
  }

  @media (min-width: 768px) {
    .social-grid {
      gap: 1.5rem;
    }
  }

  .social-card {
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
    padding: 1.5rem;
    border: 1px solid rgb(31, 41, 55);
    transition: all 0.5s ease-in-out;
    text-decoration: none;
    color: inherit;
    opacity: 0;
    animation: fadeInUp 0.6s cubic-bezier(0.16, 1, 0.3, 1) forwards;
  }

  @media (min-width: 768px) {
    .social-card {
      padding: 2rem;
      gap: 0.75rem;
    }
  }

  .social-card:hover {
    border-color: rgb(75, 85, 99);
    background: rgb(31, 41, 55);
    padding-left: 2rem;
  }

  @media (min-width: 768px) {
    .social-card:hover {
      padding-left: 3rem;
    }
  }

  .social-card:hover .social-arrow {
    transform: translateX(0.5rem);
  }

  .social-header {
    display: flex;
    justify-content: space-between;
    align-items: center;
  }

  .social-name {
    font-size: 1.25rem;
    font-weight: 700;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    transition: all 0.3s ease;
  }

  @media (min-width: 768px) {
    .social-name {
      font-size: 1.5rem;
    }
  }

  .social-arrow {
    font-size: 1.25rem;
    transition: transform 0.3s ease;
  }

  .social-handle {
    font-size: 0.875rem;
    letter-spacing: 0.1em;
    color: rgb(156, 163, 175);
  }

  .social-description {
    font-size: 0.75rem;
    letter-spacing: 0.15em;
    color: rgb(107, 114, 128);
    text-transform: uppercase;
  }

  @media (min-width: 768px) {
    .social-description {
      font-size: 0.875rem;
    }
  }
</style>
