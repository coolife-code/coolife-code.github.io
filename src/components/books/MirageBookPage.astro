  }

  .hero-stage[data-mode='gravity'] .stage-beam {
    opacity: 0.4;
  }

  .hero-stage[data-mode='gravity'] .stage-ring-a {
    width: 42rem;
    height: 42rem;
  }

  .hero-stage[data-mode='gravity'] .stage-beam {
    opacity: 0.86;
  }

  .hero-stage[data-mode='gravity'] .stage-ring-b {
    border-color: rgba(255, 199, 165, 0.28);
  }

  .hero-stage[data-mode='gravity'] .image-surface {
    filter: saturate(0.98) brightness(0.82) contrast(1.1);
  }

  .hero-stage[data-mode='gravity'] .image-panel-small {
    opacity: 0.64;
  }

  @media (min-width: 980px) {
    .mirage-page {
      padding-left: 1.5rem;
      padding-right: 1.5rem;
    }
  }

  @media (max-width: 980px) {
    .hero-stage {
      min-height: 44rem;
    }

    .hero-copy {
      max-width: min(30rem, calc(100% - 4rem));
    }

    .image-panel-main {
      width: min(58vw, 34rem);
      top: 24%;
      right: 5%;
    }

    .image-panel-top {
      right: 34%;
    }

    .image-panel-small {
      left: 28%;
    }

    .signal-switch {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }

    .lower-grid {
      grid-template-columns: 1fr;
    }
  }

  @media (max-width: 760px) {
    .mirage-page {
      padding-top: 5.4rem;
    }

    .topbar {
      grid-template-columns: auto auto;
      row-gap: 0.6rem;
      border-radius: 1.4rem;
    }

    .topbar-center {
      grid-column: 1 / -1;
      justify-content: space-between;
    }

    .hero-copy,
    .hero-stage,
    .signal-board,
    .echo-card {
      border-radius: 1.5rem;
    }

    .hero-copy h1 {
      font-size: clamp(3.2rem, 17vw, 5.4rem);
    }

    .hero-copy {
      top: 1rem;
      left: 1rem;
      max-width: calc(100% - 2rem);
      padding: 1rem 1rem 1.1rem;
    }

    .hero-stage {
      min-height: 40rem;
      padding: 0.85rem;
    }

    .collage {
      min-height: 38rem;
    }

    .image-panel-main {
      top: 40%;
      right: 1rem;
      left: 1rem;
      width: auto;
      aspect-ratio: 1.36;
      border-radius: 1.3rem;
      transform: rotate(-5deg);
    }

    .image-panel-top {
      top: 24%;
      left: 14%;
      right: auto;
      width: 38vw;
      border-radius: 1.1rem;
    }

    .image-panel-side {
      right: 0.6rem;
      bottom: 7rem;
      width: 28vw;
      border-radius: 1rem;
    }

    .image-panel-small {
      left: 0.8rem;
      bottom: 2.2rem;
      width: 34vw;
      border-radius: 1rem;
    }

    .constellation {
      inset: auto 0.4rem 6rem auto;
      width: 84vw;
    }

    .floating-panel,
    .lyric-panel {
