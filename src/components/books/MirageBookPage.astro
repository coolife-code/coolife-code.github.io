  }

  .echo-card::before {
    content: '';
    display: block;
    width: 6rem;
    height: 1px;
    margin-bottom: 0.9rem;
    background: linear-gradient(90deg, rgba(150, 206, 255, 0.72), transparent);
    box-shadow: 0 0 18px rgba(150, 206, 255, 0.22);
  }

  .hero-stage[data-mode='geometry'] .stage-ring {
    opacity: 1;
  }

  .hero-stage[data-mode='geometry'] .image-surface-main {
    filter: saturate(0.92) brightness(0.74) contrast(1.08);
  }

  .hero-stage[data-mode='light'] .stage-grid {
    opacity: 0.22;
  }

  .hero-stage[data-mode='light'] .constellation {
