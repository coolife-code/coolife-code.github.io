      right: 0.85rem;
      max-width: none;
      transform: none;
    }

    .floating-panel {
      top: auto;
      bottom: 0.85rem;
    }

    .lyric-panel {
      top: 7rem;
      bottom: auto;
    }

    .stage-ring-a {
      width: 24rem;
      height: 24rem;
    }

    .stage-ring-b {
      width: 16rem;
      height: 16rem;
    }

    .stage-ring-c {
      width: 9rem;
      height: 9rem;
    }

    .signal-switch {
      grid-template-columns: 1fr;
    }
  }
</style>

<script is:inline>
  const heroStage = document.querySelector('.hero-stage');

  if (heroStage) {
    const buttons = Array.from(document.querySelectorAll('[data-mode-trigger]'));
    const titleNode = heroStage.querySelector('[data-mode-title]');
    const copyNode = heroStage.querySelector('[data-mode-copy]');

    const setMode = (mode, title, copy, currentButton) => {
      heroStage.dataset.mode = mode;
      if (titleNode) titleNode.textContent = title;
      if (copyNode) copyNode.textContent = copy;

      buttons.forEach((button) => {
        const active = button === currentButton;
        button.classList.toggle('is-active', active);
        button.setAttribute('aria-selected', active ? 'true' : 'false');
      });
    };

    buttons.forEach((button) => {
      button.addEventListener('click', () => {
        setMode(
          button.dataset.mode || 'geometry',
          button.dataset.title || '',
          button.dataset.copy || '',
          button,
        );
      });
    });

    const updatePointer = (event) => {
      const rect = heroStage.getBoundingClientRect();
      const x = event.clientX - rect.left;
      const y = event.clientY - rect.top;
      const px = x - rect.width / 2;
      const py = y - rect.height / 2;
      heroStage.style.setProperty('--mx', `${px}px`);
      heroStage.style.setProperty('--my', `${py}px`);
      heroStage.style.setProperty('--rx', `${(py / rect.height) * -7}deg`);
      heroStage.style.setProperty('--ry', `${(px / rect.width) * 8}deg`);
    };

    const resetPointer = () => {
      heroStage.style.setProperty('--mx', '0px');
      heroStage.style.setProperty('--my', '0px');
      heroStage.style.setProperty('--rx', '0deg');
      heroStage.style.setProperty('--ry', '0deg');
    };

    heroStage.addEventListener('pointermove', updatePointer);
    heroStage.addEventListener('pointerleave', resetPointer);
  }
</script>
