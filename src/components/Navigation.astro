---
import DotMatrixText from './DotMatrixText.astro';

interface Props {
  currentPage?: string;
}

const { currentPage = '' } = Astro.props;

const navItems = [
  { number: '1', label: 'HOME', href: '/' },
  { number: '2', label: 'BOOKS', href: '/books' },
  { number: '3', label: 'WORKS', href: '/works' },
  { number: '4', label: 'ABOUT', href: '/about' },
];
---

<nav class="fixed top-0 left-0 w-full z-50">
  <div class="flex items-center justify-end p-6 md:p-8">
    <div class="nav-actions">
      <button 
        id="theme-toggle"
        class="theme-toggle"
        aria-label="Toggle theme"
      >
        <svg id="theme-icon" xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
          <path d="M21 12.79A9 9 0 1 1 11.21 3 7 7 0 0 0 21 12.79z"></path>
        </svg>
      </button>
      
      <button 
        id="menu-toggle"
        class="nav-toggle"
        aria-label="Toggle menu"
      >
        <DotMatrixText 
          text="EXPLORE" 
          dotSize={2} 
          dotSpacing={1} 
          charSpacing={3}
          class="nav-toggle-text"
        />
      </button>
    </div>
  </div>
</nav>

<div 
  id="menu-overlay" 
  class="menu-overlay"
>
  <div class="menu-content">
    <div class="menu-header">
      <span class="menu-title">- Even the light hesitates</span>
      <button 
        id="menu-close"
        class="menu-close"
        aria-label="Close menu"
      >
        <DotMatrixText 
          text="CLOSE" 
          dotSize={2} 
          dotSpacing={1} 
          charSpacing={3}
          class="menu-close-text"
        />
      </button>
    </div>
    
    <nav class="menu-nav">
      {navItems.map((item, index) => (
        <a 
          href={item.href}
          class={`menu-link ${currentPage === item.href ? 'menu-link-active' : ''}`}
          style={`animation-delay: ${index * 0.1}s`}
        >
          <DotMatrixText 
            text={item.label} 
            dotSize={4} 
            dotSpacing={2} 
            charSpacing={6}
            class="menu-link-text"
          />
        </a>
      ))}
    </nav>
  </div>
</div>

<style>
  .nav-actions {
    display: flex;
    align-items: center;
    gap: 1rem;
  }

  .theme-toggle {
    color: var(--text-color);
    background: transparent;
    border: none;
    cursor: pointer;
    padding: 0.5rem;
    opacity: 0.7;
    transition: opacity 0.3s ease;
  }

  .theme-toggle:hover {
    opacity: 1;
  }

  .nav-toggle {
    color: var(--text-color);
    background: transparent;
    border: none;
    cursor: pointer;
    padding: 0.5rem;
    transition: all 0.3s ease;
    display: flex;
    align-items: center;
  }

  .nav-toggle:hover {
    opacity: 0.7;
  }

  .menu-overlay {
    position: fixed;
    inset: 0;
    background: var(--bg-color);
    z-index: 40;
    opacity: 0;
    pointer-events: none;
    transition: opacity 0.7s ease-in-out;
  }

  .menu-overlay.active {
    opacity: 1;
    pointer-events: auto;
  }

  .menu-content {
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    height: 100%;
    position: relative;
    padding: 2rem;
  }

  .menu-header {
    position: absolute;
    top: 0;
    left: 0;
    right: 0;
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 1.5rem 2rem;
  }

  @media (min-width: 768px) {
    .menu-header {
      padding: 2rem 2.5rem;
    }
  }

  .menu-title {
    color: var(--text-color);
    font-size: 0.75rem;
    letter-spacing: 0.2em;
    text-transform: uppercase;
    font-weight: 500;
  }

  @media (min-width: 768px) {
    .menu-title {
      font-size: 0.875rem;
    }
  }

  .menu-author {
    color: var(--text-color);
    font-size: 0.75rem;
    letter-spacing: 0.15em;
    opacity: 0.7;
    margin-left: 1rem;
  }

  @media (min-width: 768px) {
    .menu-author {
      font-size: 0.875rem;
    }
  }

  .menu-close {
    color: var(--text-color);
    background: transparent;
    border: none;
    cursor: pointer;
    padding: 0.5rem;
    transition: all 0.3s ease;
    display: flex;
    align-items: center;
  }

  .menu-close:hover {
    opacity: 0.7;
  }

  .menu-nav {
    text-align: center;
    display: flex;
    flex-direction: column;
    gap: 1rem;
  }

  .menu-link {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 1rem;
    color: var(--text-color);
    transition: all 0.5s ease-in-out;
    padding: 0.5rem 0;
    opacity: 0;
    transform: translateY(2rem);
    text-decoration: none;
  }

  .menu-overlay.active .menu-link {
    opacity: 1;
    transform: translateY(0);
    transition: all 0.6s cubic-bezier(0.16, 1, 0.3, 1);
  }

  .menu-link:hover {
    opacity: 0.7;
  }

  .menu-link-active {
    opacity: 0.5;
  }

  .menu-link-text {
    display: inline-block;
  }
</style>

<script>
  // 菜单功能
  const menuToggle = document.getElementById('menu-toggle');
  const menuClose = document.getElementById('menu-close');
  const menuOverlay = document.getElementById('menu-overlay');

  function openMenu() {
    menuOverlay?.classList.add('active');
    document.body.style.overflow = 'hidden';
  }

  function closeMenu() {
    menuOverlay?.classList.remove('active');
    document.body.style.overflow = '';
  }

  menuToggle?.addEventListener('click', openMenu);
  menuClose?.addEventListener('click', closeMenu);

  menuOverlay?.querySelectorAll('a').forEach(link => {
    link.addEventListener('click', closeMenu);
  });

  document.addEventListener('keydown', (e) => {
    if (e.key === 'Escape') {
      closeMenu();
    }
  });

  // 主题切换功能
  const themeToggle = document.getElementById('theme-toggle');
  const themeIcon = document.getElementById('theme-icon');
  
  // 月亮图标 SVG
  const moonIcon = `<path d="M21 12.79A9 9 0 1 1 11.21 3 7 7 0 0 0 21 12.79z"></path>`;
  // 太阳图标 SVG
  const sunIcon = `<circle cx="12" cy="12" r="5"></circle><line x1="12" y1="1" x2="12" y2="3"></line><line x1="12" y1="21" x2="12" y2="23"></line><line x1="4.22" y1="4.22" x2="5.64" y2="5.64"></line><line x1="18.36" y1="18.36" x2="19.78" y2="19.78"></line><line x1="1" y1="12" x2="3" y2="12"></line><line x1="21" y1="12" x2="23" y2="12"></line><line x1="4.22" y1="19.78" x2="5.64" y2="18.36"></line><line x1="18.36" y1="5.64" x2="19.78" y2="4.22"></line>`;

  // 获取保存的主题或默认使用深色
  function getSavedTheme() {
    if (typeof localStorage !== 'undefined') {
      return localStorage.getItem('theme') || 'dark';
    }
    return 'dark';
  }

  // 保存主题
  function saveTheme(theme) {
    if (typeof localStorage !== 'undefined') {
      localStorage.setItem('theme', theme);
    }
  }

  // 应用主题
  function applyTheme(theme) {
    if (theme === 'light') {
      document.documentElement.setAttribute('data-theme', 'light');
      if (themeIcon) themeIcon.innerHTML = sunIcon;
    } else {
      document.documentElement.removeAttribute('data-theme');
      if (themeIcon) themeIcon.innerHTML = moonIcon;
    }
  }

  // 切换主题
  function toggleTheme() {
    const currentTheme = document.documentElement.getAttribute('data-theme');
    const newTheme = currentTheme === 'light' ? 'dark' : 'light';
    applyTheme(newTheme);
    saveTheme(newTheme);
  }

  // 初始化主题
  const savedTheme = getSavedTheme();
  applyTheme(savedTheme);

  // 绑定切换事件
  themeToggle?.addEventListener('click', toggleTheme);
</script>
