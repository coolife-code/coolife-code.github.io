---
interface Props {
  currentPage?: string;
}

const { currentPage = '' } = Astro.props;

const navItems = [
  { number: '1', label: 'HOME', href: '/' },
  { number: '2', label: 'BOOKS', href: '/books' },
  { number: '3', label: 'WORKS', href: '/works' },
  { number: '4', label: 'ABOUT', href: '/about' },
];
---

<nav class="fixed top-0 left-0 w-full z-50">
  <div class="flex items-center justify-between p-6 md:p-8">
    <a href="/" class="nav-logo">
      EVEN THE DEVIL SMILES
    </a>
    
    <div class="nav-actions">
      <button 
        id="theme-toggle"
        class="theme-toggle"
        aria-label="Toggle theme"
      >
        <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
          <path d="M21 12.79A9 9 0 1 1 11.21 3 7 7 0 0 0 21 12.79z"></path>
        </svg>
      </button>
      
      <button 
        id="menu-toggle"
        class="nav-toggle"
        aria-label="Toggle menu"
      >
        EXPLORE
      </button>
    </div>
  </div>
</nav>

<div 
  id="menu-overlay" 
  class="menu-overlay"
>
  <div class="menu-content">
    <div class="menu-header">
      <span class="menu-title">EVEN THE DEVIL SMILES</span>
      <button 
        id="menu-close"
        class="menu-close"
        aria-label="Close menu"
      >
        CLOSE
      </button>
    </div>
    
    <nav class="menu-nav">
      {navItems.map((item, index) => (
        <a 
          href={item.href}
          class={`menu-link ${currentPage === item.href ? 'menu-link-active' : ''}`}
          style={`animation-delay: ${index * 0.1}s`}
        >
          <span class="menu-number">{item.number}.</span>
          <span class="menu-label">{item.label}</span>
        </a>
      ))}
    </nav>
  </div>
</div>

<style>
  .nav-logo {
    color: white;
    font-size: 0.75rem;
    letter-spacing: 0.2em;
    text-transform: uppercase;
    font-weight: 500;
    transition: all 0.3s ease-in-out;
  }

  .nav-logo:hover {
    opacity: 0.7;
  }

  @media (min-width: 768px) {
    .nav-logo {
      font-size: 0.875rem;
    }
  }

  .nav-actions {
    display: flex;
    align-items: center;
    gap: 1rem;
  }

  .theme-toggle {
    color: white;
    background: transparent;
    border: none;
    cursor: pointer;
    padding: 0.5rem;
    opacity: 0.7;
    transition: opacity 0.3s ease;
  }

  .theme-toggle:hover {
    opacity: 1;
  }

  .nav-toggle {
    color: white;
    font-size: 0.75rem;
    letter-spacing: 0.3em;
    text-transform: uppercase;
    font-weight: 500;
    transition: all 0.5s ease-in-out;
    background: transparent;
    border: none;
    cursor: pointer;
    padding: 0.5rem 1rem;
  }

  .nav-toggle:hover {
    letter-spacing: 0.5em;
    opacity: 0.7;
  }

  @media (min-width: 768px) {
    .nav-toggle {
      font-size: 0.875rem;
    }
  }

  .menu-overlay {
    position: fixed;
    inset: 0;
    background: black;
    z-index: 40;
    opacity: 0;
    pointer-events: none;
    transition: opacity 0.7s ease-in-out;
  }

  .menu-overlay.active {
    opacity: 1;
    pointer-events: auto;
  }

  .menu-content {
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    height: 100%;
    position: relative;
    padding: 2rem;
  }

  .menu-header {
    position: absolute;
    top: 0;
    left: 0;
    right: 0;
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 1.5rem 2rem;
  }

  @media (min-width: 768px) {
    .menu-header {
      padding: 2rem 2.5rem;
    }
  }

  .menu-title {
    color: white;
    font-size: 0.75rem;
    letter-spacing: 0.2em;
    text-transform: uppercase;
    font-weight: 500;
  }

  @media (min-width: 768px) {
    .menu-title {
      font-size: 0.875rem;
    }
  }

  .menu-close {
    color: white;
    font-size: 0.75rem;
    letter-spacing: 0.3em;
    text-transform: uppercase;
    font-weight: 500;
    transition: all 0.5s ease-in-out;
    background: transparent;
    border: none;
    cursor: pointer;
    padding: 0.5rem 1rem;
  }

  .menu-close:hover {
    letter-spacing: 0.5em;
    opacity: 0.7;
  }

  @media (min-width: 768px) {
    .menu-close {
      font-size: 0.875rem;
    }
  }

  .menu-nav {
    text-align: center;
  }

  .menu-link {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 0.75rem;
    color: white;
    font-size: 1.875rem;
    letter-spacing: 0.15em;
    text-transform: uppercase;
    font-weight: 700;
    transition: all 0.5s ease-in-out;
    padding: 0.75rem 0;
    opacity: 0;
    transform: translateY(2rem);
  }

  @media (min-width: 768px) {
    .menu-link {
      gap: 1rem;
      font-size: 3rem;
      padding: 1rem 0;
    }
  }

  @media (min-width: 1024px) {
    .menu-link {
      font-size: 3.75rem;
    }
  }

  .menu-overlay.active .menu-link {
    opacity: 1;
    transform: translateY(0);
    transition: all 0.6s cubic-bezier(0.16, 1, 0.3, 1);
  }

  .menu-link:hover {
    letter-spacing: 0.25em;
    opacity: 0.7;
  }

  .menu-link-active {
    opacity: 0.5;
  }

  .menu-number {
    font-size: 0.875rem;
    font-weight: 400;
    letter-spacing: 0.1em;
    opacity: 0.5;
  }

  @media (min-width: 768px) {
    .menu-number {
      font-size: 1rem;
    }
  }

  .menu-label {
    font-weight: 700;
  }
</style>

<script>
  const menuToggle = document.getElementById('menu-toggle');
  const menuClose = document.getElementById('menu-close');
  const menuOverlay = document.getElementById('menu-overlay');

  function openMenu() {
    menuOverlay?.classList.add('active');
    document.body.style.overflow = 'hidden';
  }

  function closeMenu() {
    menuOverlay?.classList.remove('active');
    document.body.style.overflow = '';
  }

  menuToggle?.addEventListener('click', openMenu);
  menuClose?.addEventListener('click', closeMenu);

  menuOverlay?.querySelectorAll('a').forEach(link => {
    link.addEventListener('click', closeMenu);
  });

  document.addEventListener('keydown', (e) => {
    if (e.key === 'Escape') {
      closeMenu();
    }
  });
</script>
